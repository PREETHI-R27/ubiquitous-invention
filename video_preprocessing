import cv2
import numpy as np
import matplotlib.pyplot as plt

video_path = '/content/video_2025-07-29_14-36-41.mp4'

cap = cv2.VideoCapture(video_path)
if not cap.isOpened():
    print("Error opening video")
    exit()

total_fames = int(cap.get(cv2.CAP_PROP_FRAME_COUNT))
fps = cap.get(cv2.CAP_PROP_FPS)
width = int(cap.get(cv2.CAP_PROP_FRAME_WIDTH))
height = int(cap.get(cv2.CAP_PROP_FRAME_HEIGHT))
duration = total_fames / fps

print("path - ", cap)
print("total frames - ", total_fames)
print("fps - ", fps)
print("width - ", width)
print("height - ", height)
print("duration - ", duration)
print("resolution - ", width * height)

total_frames = int(cap.get(cv2.CAP_PROP_FRAME_COUNT))
if total_frames <= 3:
    print("Video has less than 3 frames. Displaying all frames.")
    frames_to_display = list(range(total_frames))
else:
    frames_to_display = np.random.choice(total_frames, 3, replace=False)

plt.figure(figsize=(15, 5))

for i, frame_index in enumerate(frames_to_display):
    # Seek to the random frame
    cap.set(cv2.CAP_PROP_POS_FRAMES, frame_index)
    ret, frame = cap.read()

    if ret:
        plt.subplot(1, 3, i + 1)
        plt.imshow(cv2.cvtColor(frame, cv2.COLOR_BGR2RGB))
        plt.title(f'Random Frame {frame_index}')
        plt.axis('off')
    else:
        print(f"Could not read frame {frame_index}")

plt.tight_layout()
plt.show()

cap.set(cv2.CAP_PROP_POS_FRAMES, 0)

# Process only the first frame
ret, frame = cap.read()
if ret:
    # Get frame dimensions
    height, width = frame.shape[:2]

    # 1. Resize to 50% of original size
    resized = cv2.resize(frame, (int(width * 0.5), int(height * 0.5)))

    # 2. Apply Gaussian blur filter
    filtered = cv2.GaussianBlur(frame, (5, 5), 0)

    # 3. Rotate by 45 degrees
    center = (width / 2, height / 2)
    M_rot = cv2.getRotationMatrix2D(center, 45, 1.0)
    rotated = cv2.warpAffine(frame, M_rot, (width, height))

    # 4. Edge detection with Canny
    gray = cv2.cvtColor(frame, cv2.COLOR_BGR2GRAY)
    edges = cv2.Canny(gray, 100, 200)

    # 5. Normalize pixel values
    normalized = cv2.normalize(frame, None, 0, 255, cv2.NORM_MINMAX)

    # Display all processed images in a 2x3 grid
    plt.figure(figsize=(15, 10))

    plt.subplot(2, 3, 1)
    plt.imshow(cv2.cvtColor(frame, cv2.COLOR_BGR2RGB)) # Original frame
    plt.title('Original Frame')
    plt.axis('off')

    plt.subplot(2, 3, 2)
    plt.imshow(cv2.cvtColor(resized, cv2.COLOR_BGR2RGB))
    plt.title('Resized Frame')
    plt.axis('off')

    plt.subplot(2, 3, 3)
    plt.imshow(cv2.cvtColor(filtered, cv2.COLOR_BGR2RGB))
    plt.title('Filtered Frame (Gaussian Blur)')
    plt.axis('off')

    plt.subplot(2, 3, 4)

    plt.imshow(edges, cmap='gray')
    plt.title('Edge Detected Frame (Canny)')
    plt.axis('off')

    plt.subplot(2, 3, 5)
    plt.imshow(cv2.cvtColor(normalized, cv2.COLOR_BGR2RGB))
    plt.title('Normalized Frame')
    plt.axis('off')

    plt.tight_layout()
    plt.show()

cap.release()
