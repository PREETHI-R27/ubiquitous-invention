# PERFORM JOIN OPERATIONS
DATABASE_URL = 'postgresql'
result = urlparse(DATABASE_URL)

conn = psycopg2.connect(
    host=result.hostname,
    port=result.port or 5432,
    dbname=result.path.lstrip('/'),
    user=result.username,
    password=result.password,
    sslmode='require'
)
cur = conn.cursor()

# Inner Join
cur.execute("""
    SELECT z.customer, z.restaurant, z.amount, d.name AS delivery_person
    FROM zomato z
    INNER JOIN delivery d ON z.delivery_id = d.delivery_id
""")
print("Inner Join Results:")
for row in cur.fetchall():
    print(row)

# Left Join
cur.execute("""
    SELECT d.name AS delivery_person, z.customer, z.restaurant
    FROM delivery d
    LEFT JOIN zomato z ON d.delivery_id = z.delivery_id
""")
print("Left Join Results:")
for row in cur.fetchall():
    print(row)

# Right Join
cur.execute("""
    SELECT z.customer, z.restaurant, d.name AS delivery_person
    FROM zomato z
    RIGHT JOIN delivery d ON z.delivery_id = d.delivery_id
""")
print("Right Join Results:")
for row in cur.fetchall():
    print(row)

# Cross Join (Limited)
cur.execute("""
    SELECT z.customer, d.name AS delivery_person
    FROM zomato z
    CROSS JOIN delivery d
    LIMIT 8
""")
print("Cross Join Results (Limited):")
for row in cur.fetchall():
    print(row)

cur.close()
conn.close()

